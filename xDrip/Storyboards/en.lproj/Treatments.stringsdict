<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>novopen_readingDoses</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Reading pen… %#@doses@</string>
		<key>doses</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d dose</string>
			<key>other</key>
			<string>%d doses</string>
		</dict>
	</dict>
	<key>novopen_importedDoses</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Imported %#@doses@</string>
		<key>doses</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d dose</string>
			<key>other</key>
			<string>%d doses</string>
		</dict>
	</dict>
	<key>novopen_skippedEntries</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>, skipped %#@entries@</string>
		<key>entries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d error entry</string>
			<key>other</key>
			<string>%d error entries</string>
		</dict>
	</dict>
</dict>
</plist>
